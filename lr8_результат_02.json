 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    indices = rng.integers(0, len(F), size=k)\n    return int(indices[np.argmin(F[indices])])\n",
  "ox": "def ox(p1, p2, i, j):\n    n = len(p1)\n    child = np.empty_like(p1)\n    child[i:j + 1] = p1[i:j + 1]\n\n    used = set(p1[i:j + 1])\n    pos = (j + 1) % n\n\n    for offset in range(n):\n        gene = p2[(j + 1 + offset) % n]\n        if gene not in used:\n            child[pos] = gene\n            used.add(gene)\n            pos = (pos + 1) % n\n\n    return child\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    points = np.array(left, dtype=int)\n    weights = tau[cur, points] ** alpha * eta[cur, points] ** beta\n    total = weights.sum()\n\n    if total == 0:\n        return int(rng.choice(points))\n\n    probabilities = weights / total\n    return int(rng.choice(points, p=probabilities))\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new_tau = (1 - rho) * tau\n\n    for genome, length in zip(tours, lens):\n        route = [0] + list(genome) + [0]\n        deposit = 1.0 / length\n\n        for a, b in zip(route[:-1], route[1:]):\n            new_tau[a, b] += deposit\n\n    return new_tau\n"
 },
